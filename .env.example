# Ollama settings (must match your whatsapp_brain project)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Your existing RAG server (whatsapp_brain running on port 8000)
# If you want to use it as a proxy instead of calling Ollama directly
RAG_SERVER_URL=http://localhost:8000

# How the bot should identify itself
BOT_NAME=WhatsApp Brain

# Only reply to messages from these numbers (comma separated, with country code)
# Leave empty to reply to ALL messages
ALLOWED_NUMBERS=

# Ignore messages from yourself (recommended: true)
IGNORE_SELF=true

# Add a typing delay to seem more human (milliseconds)
TYPING_DELAY=2000

# Dashboard web server port (open http://localhost:3001 in your browser)
DASHBOARD_PORT=3001

# Conversation history TTL and human takeover duration
HISTORY_TTL_HOURS=48
TAKEOVER_MINUTES=30

# Vision model for image analysis
OLLAMA_VISION_MODEL=llama3.2-vision
