# WhatsApp Cloud API credentials (from Meta Developer Portal)
WHATSAPP_TOKEN=your_temporary_access_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
VERIFY_TOKEN=whatsapp_brain_verify

# OpenAI API key — leave empty to use Ollama (local) for embeddings + inference
OPENAI_API_KEY=

# Optional: path overrides
DOCS_DIR=../docs
VECTOR_STORE_PATH=vector_store
CORRECTIONS_FILE=corrections.json
